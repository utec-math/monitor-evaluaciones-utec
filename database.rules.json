{
  "rules": {
    "sessions": {
      "$session": {
        ".read": "auth != null",
        ".write": "auth != null",
        "config": {
          ".read": true,
          ".write": "auth != null"
        },
        "commands": {
          "$studentId": {
            ".read": true,
            ".write": "auth != null"
          }
        },
        "clients": {
          "$studentId": {
            ".read": "auth != null",
            ".write": "auth != null || (newData.hasChildren(['id','lastSeen','app']) && newData.child('id').val() === $studentId)"
          }
        },
        "students": {
          "$studentId": {
            ".write": "auth != null || (newData.hasChildren(['id','name','level','lastSeen','connected']) && newData.child('id').val() === $studentId)"
          }
        },
        "events": {
          "$eventId": {
            ".write": "auth != null || (!data.exists() && newData.hasChildren(['studentId','studentName','type','level']))"
          }
        }
      }
    }
  }
}